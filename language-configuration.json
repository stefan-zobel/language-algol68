{
  "comments": {
    "blockComment": ["{", "}"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["begin", "end"],
    ["if", "fi"],
    ["case", "esac"],
    ["do", "od"],
    ["def", "fed"],
    ["BEGIN", "END"],
    ["IF", "FI"],
    ["CASE", "ESAC"],
    ["DO", "OD"],
    ["DEF", "FED"]
  ],
  "colorizedBracketPairs": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}", "notIn": ["string"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z][A-Za-z0-9_]*|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?",
  "indentationRules": {
    "increaseIndentPattern": "^.*\\b(begin|then|else|elif|do|in|out|ouse|def|BEGIN|THEN|ELSE|ELIF|DO|IN|OUT|OUSE|DEF)\\b(?!.*\\b(end|fi|od|esac|fed|END|FI|OD|ESAC|FED)\\b)[^{}]*$",
    "decreaseIndentPattern": "^\\s*(end|fi|od|esac|fed|else|elif|then|in|out|ouse|END|FI|OD|ESAC|FED|ELSE|ELIF|THEN|IN|OUT|OUSE)\\b"
  }
}
