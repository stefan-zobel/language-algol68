          }
        }
      ]
    },
    "s-keyword": {
      "patterns": [
        {
          "match": "\\b(?:assert|begin|while|case|elif|else|esac|exit|from|goto|ouse|then|end|for|out|par|by|do|fi|go|if|in|od|to)\\b",
          "name": "keyword.control.algol68"
        },
        {
          "match": "\\b(?:postlude|module|def|egg|fed)\\b",
          "name": "keyword.other.module.algol68"
        },
        {
          "match": "\\b(?:mode|prio|proc|op)\\b",
          "name": "storage.type.declaration.algol68"
        },
        {
          "match": "\\b(?:channel|string|bytes|compl|bits|bool|char|file|real|sema|void|int)\\b",
          "name": "storage.type.primitive.algol68"
        },
        {
          "match": "\\b(?:struct|short|union|flex|heap|long|word|loc|ref)\\b",
          "name": "storage.modifier.algol68"
        },
        {
          "match": "\\b(?:empty|false|skip|true|nil)\\b",
          "name": "constant.language.algol68"
        },
        {
          "match": "\\b(?:andth|isnt|orel|at|is|of)\\b",
          "name": "keyword.operator.wordlike.algol68"
        }
      ]
    },
    "s-standard": {
      "patterns": [
        {
          "match": "\\b(?:(?:long|short|word)_?)*(?:minus_?infinity|bytes_?width|bits_?width|real_?width|small_?real|exp_?width|int_?width|infinity|max_?bits|max_?real|min_?real|max_?int|min_?int|pi)\\b",
          "name": "support.constant.algol68"
        },
        {
          "match": "\\b(?:(?:long|short|word)_?)*(?:string_?to_?real|next_?random|bytes_?pack|bits_?pack|arccos|arcsin|arctan|random|sqrt|cos|exp|log|sin|tan|ln)\\b",
          "name": "support.function.algol68"
        },
        {
          "match": "\\b(?:replacement_?char|file_?o_?default|null_?character|bytes_?lengths|bytes_?shorths|compl_?lengths|compl_?shorths|file_?o_?rdonly|file_?o_?wronly|bits_?lengths|bits_?shorths|file_?o_?trunc|max_?abs_?char|real_?lengths|real_?shorths|file_?o_?rdwr|int_?lengths|int_?shorths|error_?char|eof_?char|seek_?cur|seek_?end|seek_?set|stderr|stdout|blank|stdin|flip|flop)\\b",
          "name": "support.constant.algol68"
        },
        {
          "match": "\\b(?:char_?in_?string|first_?random|posix_?exit|fconnect|strerror|fcreate|getchar|putchar|fclose|getenv|perror|errno|fgetc|fgets|fixed|float|fopen|fputc|fputs|fsize|lseek|print|whole|argc|argv|gets|puts|read|get|put|rnd)\\b",
          "name": "support.function.algol68"
        }
      ]
    },
    "s-bold": {
      "patterns": [
        {
          "match": "\\b(?:MINUSAB|SHORTEN|TIMESAB|ENTIER|OVERAB|PLUSAB|PLUSTO|CLEAR|DIVAB|ELEMS|FLOOR|LEVEL|MODAB|ROUND|CONJ|DOWN|ELEM|LENG|OVER|REPR|SIGN|TEST|ABS|AND|ARG|BIN|LWB|MOD|NOT|ODD|SET|SHL|SHR|UPB|XOR|EQ|GE|GT|IM|LE|LT|NE|OR|RE|UP|I)\\b",
          "name": "support.function.operator.algol68"
        },
        {
          "comment": "capitals, digits and _ only (at least two characters): operator",
          "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b",
          "name": "entity.name.function.operator.algol68"
        },
        {
          "comment": "otherwise: mode indicant (Int_list, Node, F)",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.algol68"
        }
      ]
    },
    "s-mixed": {
      "comment": "an identifier that runs into a bold word (foo_Bar, fooBar): in SUPPER two tokens and almost always a mistake",
      "match": "\\b[a-z][a-z0-9_]*[A-Z][A-Za-z0-9_]*\\b",
      "name": "invalid.illegal.mixed-tag.algol68"
    },
    "s-identifier": {
      "comment": "Ordinary identifiers stay without color, but are consumed as a whole, so that no part of them counts as a number or the like.",
      "match": "\\b[a-z][a-z0-9_]*\\b",
      "name": "variable.other.algol68"
    },
    "s-operator": {
      "patterns": [
        {
          "match": ":/=:|:=:",
          "name": "keyword.operator.identity.algol68"
        },
        {
          "comment": "+:=, -:=, *:=, /:=, %:=, %*:= and +=: (PLUSTO)",
          "match": "[-+*/%^&~<>=!?]+(?::=|=:)",
          "name": "keyword.operator.assignment.compound.algol68"
        },
        {
          "match": ":=",
          "name": "keyword.operator.assignment.algol68"
        },
        {
          "match": "=:",
          "name": "keyword.operator.assignment.algol68"
        },
        {
          "match": "[-+*/%^&~<>=!?]+",
          "name": "keyword.operator.algol68"
        },
        {
          "match": "@",
          "name": "keyword.operator.at.algol68"
        }
      ]
    },
    "s-punctuation": {
      "patterns": [
        {
          "comment": "characters that ga68 rejects outside strings and comments (unworthy character), e.g. ×, ¬, ≠, \\ and `",
          "match": "[^\\x00-\\x7F]|[\\\\`]",
          "name": "invalid.illegal.unworthy.algol68"
        },
        {
          "match": "\\|:|\\|",
          "name": "keyword.control.brief.algol68"
        },
        {
          "match": ";",
          "name": "punctuation.separator.semicolon.algol68"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.algol68"
        },
        {
          "match": ":",
          "name": "punctuation.separator.colon.algol68"
        },
        {
          "match": "[()]",
          "name": "punctuation.parenthesis.algol68"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.brackets.algol68"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.algol68"
        }
      ]
    }
  }
}
