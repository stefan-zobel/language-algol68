{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Algol 68",
  "scopeName": "source.algol68",
  "fileTypes": [
    "a68"
  ],
  "comment": "Algol 68 in UPPER stropping (Revised Report, Algol 68 Genie, ga68) and in SUPPER stropping (ga68); the first reserved word decides.",
  "patterns": [
    {
      "include": "#s-comment"
    },
    {
      "include": "#upper"
    },
    {
      "include": "#supper"
    },
    {
      "include": "#u-string"
    },
    {
      "include": "#u-number"
    },
    {
      "include": "#u-standard"
    },
    {
      "include": "#s-bold"
    },
    {
      "include": "#u-identifier"
    },
    {
      "include": "#u-operator"
    },
    {
      "include": "#u-punctuation"
    }
  ],
  "repository": {
    "upper": {
      "comment": "UPPER stropping: from the first reserved word in capitals or # to the end of the file",
      "begin": "(?=#|(?<![A-Z_])(?:POSTLUDE|CHANNEL|COMMENT|COMPLEX|PRAGMAT|ACCESS|ASSERT|DOWNTO|FORMAT|MODULE|STRING|STRUCT|ANDTH|BEGIN|BYTES|COMPL|EMPTY|FALSE|SHORT|SOUND|UNION|UNTIL|WHILE|ANDF|BITS|BOOL|CASE|CHAR|ELIF|ELSE|ESAC|EXIT|FILE|FLEX|FROM|GOTO|HEAP|ISNT|LONG|MODE|NOTE|OREL|OUSE|PIPE|PRIO|PROC|REAL|SEMA|SKIP|THEN|TRUE|VOID|WORD|DEF|EGG|END|FED|FOR|INT|LOC|NEW|NIL|ORF|OUT|PAR|PUB|REF|AT|BY|CO|DO|FI|GO|IF|IN|IS|OD|OF|OP|PR|TO)(?![A-Z_]))",
      "end": "(?!)",
      "patterns": [
        {
          "include": "#u-comment"
        },
        {
          "include": "#u-pragmat"
        },
        {
          "include": "#u-string"
        },
        {
          "include": "#u-format"
        },
        {
          "include": "#u-number"
        },
        {
          "include": "#u-module"
        },
        {
          "include": "#u-declaration"
        },
        {
          "include": "#u-label"
        },
        {
          "include": "#u-keyword"
        },
        {
          "include": "#u-standard"
        },
        {
          "include": "#u-bold"
        },
        {
          "include": "#u-identifier"
        },
        {
          "include": "#u-operator"
        },
        {
          "include": "#u-punctuation"
        }
      ]
    },
    "supper": {
      "comment": "SUPPER stropping: from the first reserved word in lower case or [[ to the end of the file",
      "begin": "(?=\\[\\[|\\b(?:postlude|access|assert|module|struct|andth|begin|false|union|while|bool|case|elif|else|esac|flex|goto|heap|isnt|mode|orel|ouse|prio|proc|skip|then|true|void|end|for|int|loc|nil|par|pub|ref|do|fi|if|od|op)\\b)",
      "end": "(?!)",
      "patterns": [
        {
          "include": "#s-comment"
        },
        {
          "include": "#s-pragmat"
        },
        {
          "include": "#s-string"
        },
        {
          "include": "#s-format"
        },
        {
          "include": "#s-number"
        },
        {
          "include": "#s-module"
        },
        {
          "include": "#s-mixed"
        },
        {
          "include": "#s-declaration"
        },
        {
          "include": "#s-label"
        },
        {
          "include": "#s-keyword"
        },
        {
          "include": "#s-standard"
        },
        {
          "include": "#s-bold"
        },
        {
          "include": "#s-identifier"
        },
        {
          "include": "#s-operator"
        },
        {
          "include": "#s-punctuation"
        }
      ]
    },
    "u-comment": {
      "patterns": [
        {
          "include": "#s-comment"
        },
        {
          "comment": "NOTE ... ETON (GNU): nestable, a \"...\" inside is skipped",
          "name": "comment.block.note.algol68",
          "begin": "\\bNOTE\\b",
          "end": "ETON",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.algol68"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.algol68"
            }
          },
          "patterns": [
            {
              "include": "#u-note"
            },
            {
              "include": "#u-comment-content"
            }
          ]
        },
        {
          "name": "comment.block.bold.algol68",
          "begin": "\\bCOMMENT\\b",
          "end": "COMMENT",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.algol68"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.algol68"
            }
          },
          "patterns": [
            {
              "include": "#u-todo"
            }
          ]
        },
        {
          "name": "comment.block.co.algol68",
          "begin": "\\bCO\\b",
          "end": "CO",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.algol68"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.algol68"
            }
          },
          "patterns": [
            {
              "include": "#u-todo"
            }
          ]
        },
        {
          "name": "comment.block.hash.algol68",
          "begin": "#",
          "end": "#",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.algol68"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.algol68"
            }
          },
          "patterns": [
            {
              "include": "#u-todo"
            }
          ]
        }
      ]
    },
    "u-note": {
      "begin": "\\bNOTE\\b",
      "end": "ETON",
      "patterns": [
        {
          "include": "#u-note"
        },
        {
          "include": "#u-comment-content"
        }
      ]
    },
    "u-comment-content": {
      "patterns": [
        {
          "comment": "a string in a nestable comment: its end delimiter does not count",
          "begin": "\"",
          "end": "\"",
          "name": "comment.block.string.algol68"
        },
        {
          "include": "#u-todo"
        }
      ]
    },
    "u-todo": {
      "match": "\\b(?:TODO|FIXME|XXX)\\b",
      "name": "keyword.other.todo.algol68"
    },
    "u-pragmat": {
      "comment": "PR ... PR, PRAGMAT ... PRAGMAT and ORDER ... REDRO (GNU)",
      "patterns": [
        {
          "name": "meta.preprocessor.pragmat.algol68",
          "begin": "\\bPRAGMAT\\b",
          "end": "PRAGMAT",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.pragmat.begin.algol68"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.pragmat.end.algol68"
            }
          },
          "patterns": [
            {
              "include": "#u-pragmat-content"
            }
          ]
        },
        {
          "name": "meta.preprocessor.pragmat.algol68",
          "begin": "\\bPR\\b",
          "end": "PR",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.pragmat.begin.algol68"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.pragmat.end.algol68"
            }
          },
          "patterns": [
            {
              "include": "#u-pragmat-content"
            }
          ]
        },
        {
          "name": "meta.preprocessor.pragmat.algol68",
          "begin": "\\bORDER\\b",
          "end": "REDRO",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.pragmat.begin.algol68"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.pragmat.end.algol68"
            }
          },
          "patterns": [
            {
              "include": "#u-pragmat-content"
            }
          ]
        }
      ]
    },
    "u-pragmat-content": {
      "patterns": [
        {
          "match": "\\b(?:include|read|access)\\b",
          "name": "keyword.control.directive.algol68"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.algol68"
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.algol68"
        }
      ]
    },
    "u-string": {
      "name": "string.quoted.double.algol68",
      "begin": "\"",
      "end": "\"(?!\")",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.algol68"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.algol68"
        }
      },
      "patterns": [
        {
          "match": "\"\"",
          "name": "constant.character.escape.quote.algol68"
        },
        {
          "comment": "characters by their code (GNU): '(u00e4, U0001F600)",
          "match": "'\\(\\s*[uU][0-9A-Fa-f]+(?:\\s*,\\s*[uU][0-9A-Fa-f]+)*\\s*\\)",
          "name": "constant.character.escape.unicode.algol68"
        }
      ]
    },
    "u-format": {
      "comment": "format text $...$",
      "name": "meta.format.algol68",
      "begin": "\\$",
      "end": "\\$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.format.begin.algol68"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.format.end.algol68"
        }
      },
      "patterns": [
        {
          "include": "#u-comment"
        },
        {
          "include": "#u-string"
        },
        {
          "match": "\\d+",
          "name": "constant.numeric.format.algol68"
        },
        {
          "match": "[A-Za-z]",
          "name": "constant.other.format-item.algol68"
        },
        {
          "match": "[(),]",
          "name": "punctuation.format.algol68"
        }
      ]
    },
    "u-number": {
      "patterns": [
        {
          "comment": "bits denotation: radix 2, 4, 8, 10 (GNU) or 16",
          "match": "(?<![a-z0-9_.])(?:2[ \\t]*r[ \\t]*[01](?:[ \\t]*[01])*|4[ \\t]*r[ \\t]*[0-3](?:[ \\t]*[0-3])*|8[ \\t]*r[ \\t]*[0-7](?:[ \\t]*[0-7])*|10[ \\t]*r[ \\t]*[0-9](?:[ \\t]*[0-9])*|16[ \\t]*r[ \\t]*[0-9a-f](?:[ \\t]*[0-9a-f])*)(?![0-9a-z_])",
          "name": "constant.numeric.bits.algol68"
        },
        {
          "comment": "a wrong digit for the radix (2r03, 16rfg) or a wrong radix",
          "match": "(?<![a-z0-9_.])\\d+[ \\t]*r[ \\t]*[0-9a-z_]+",
          "name": "invalid.illegal.bits.algol68"
        },
        {
          "comment": "1.5, 1 .5, .5, 1e3, 1.e3, 1.5e-3 (also with spaces)",
          "match": "(?<![a-z0-9_.])(?:\\d(?:[ \\t]*\\d)*[ \\t]*\\.[ \\t]*\\d(?:[ \\t]*\\d)*(?:[ \\t]*[eE][ \\t]*[+-]?[ \\t]*\\d(?:[ \\t]*\\d)*)?|\\d(?:[ \\t]*\\d)*(?:[ \\t]*\\.)?[ \\t]*[eE][ \\t]*[+-]?[ \\t]*\\d(?:[ \\t]*\\d)*|\\.[ \\t]*\\d(?:[ \\t]*\\d)*(?:[ \\t]*[eE][ \\t]*[+-]?[ \\t]*\\d(?:[ \\t]*\\d)*)?)",
          "name": "constant.numeric.real.algol68"
        },
        {
          "match": "(?<![a-z0-9_.])\\d(?:[ \\t]*\\d)*",
          "name": "constant.numeric.integer.algol68"
        }
      ]
    },
    "u-module": {
      "patterns": [
        {
          "comment": "MODULE NAME = ...",
          "match": "\\b(MODULE)\\s+([A-Z][A-Z_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.module.algol68"
            },
            "2": {
              "name": "entity.name.namespace.algol68"
            }
          }
        },
        {
          "comment": "ACCESS [PUB] A, [PUB] B",
          "match": "\\b(ACCESS)\\s+((?:PUB\\s+)?[A-Z][A-Z_]*(?:\\s*,\\s*(?:PUB\\s+)?[A-Z][A-Z_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.algol68"
            },
            "2": {
              "patterns": [
                {
                  "match": "\\bPUB\\b",
                  "name": "storage.modifier.pub.algol68"
                },
                {
                  "match": "[A-Z][A-Z_]*",
                  "name": "entity.name.namespace.algol68"
                },
                {
                  "match": ",",
                  "name": "punctuation.separator.comma.algol68"
                }
              ]
            }
          }
        },
        {
          "match": "\\bACCESS\\b",
          "name": "keyword.control.import.algol68"
        },
        {
          "match": "\\bPUB\\b",
          "name": "storage.modifier.pub.algol68"
        },
        {
          "comment": "formal hole: NEST C \"name\"",
          "match": "\\b(NEST)\\s+([A-Z][A-Z_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.nest.algol68"
            },
            "2": {
              "name": "support.constant.formal-hole.language.algol68"
            }
          }
        },
        {
          "match": "\\bNEST\\b",
          "name": "keyword.other.nest.algol68"
        }
      ]
    },
    "u-declaration": {
      "patterns": [
        {
          "comment": "MODE NAME = ...",
          "match": "\\b(MODE)\\s+([A-Z][A-Z_]*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.mode.algol68"
            },
            "2": {
              "name": "entity.name.type.algol68"
            }
          }
        },
        {
          "comment": "OP NAME = ..., OP + = ..., OP +:= = ...",
          "match": "\\b(OP)\\s+([A-Z][A-Z_]*|[-+*/%^&~<>=!?×÷≤≥≠¬∧∨↑↓]+(?::=|=:)?)(?=\\s*:?=)",
          "captures": {
            "1": {
              "name": "storage.type.op.algol68"
            },
            "2": {
              "name": "entity.name.function.operator.algol68"
            }
          }
        },
        {
          "comment": "PRIO NAME = 5, PRIO + = 6",
          "match": "\\b(PRIO)\\s+([A-Z][A-Z_]*|[-+*/%^&~<>=!?×÷≤≥≠¬∧∨↑↓]+(?::=|=:)?)(?=\\s*=)",
          "captures": {
            "1": {
              "name": "storage.type.prio.algol68"
            },
            "2": {
              "name": "entity.name.function.operator.algol68"
            }
          }
        },
        {
          "comment": "PROC name = ... and PROC name := ...",
          "match": "\\b(PROC)\\s+([a-z][a-z0-9_]*+(?:[ \\t]++[a-z0-9][a-z0-9_]*+)*+)(?=\\s*:?=)",
          "captures": {
            "1": {
              "name": "storage.type.proc.algol68"
            },
            "2": {
              "name": "entity.name.function.algol68"
            }
          }
        },
        {
          "comment": "name = (INT a) INT: ... (a routine text, e.g. after PROC (INT) INT)",
          "match": "(?<![a-z0-9_])([a-z][a-z0-9_]*+(?:[ \\t]++[a-z0-9][a-z0-9_]*+)*+)(?=\\s*=(?!=)\\s*(?>\\s*\\([^()]*+\\))?(?>\\s*+(?:\\[[^\\]]*+\\]|[A-Z][A-Z_]*+))*+\\s*:(?!=))",
          "captures": {
            "1": {
              "name": "entity.name.function.algol68"
            }
          }
        }
      ]
    },
    "u-label": {
      "patterns": [
        {
          "comment": "a label at the start of a line or after ';': stop: SKIP",
          "match": "(?:^|(?<=;))\\s*([a-z][a-z0-9_]*+(?:[ \\t]++[a-z0-9][a-z0-9_]*+)*+)\\s*(:)(?![=/])",
          "captures": {
            "1": {
              "name": "entity.name.label.algol68"
            },
            "2": {
              "name": "punctuation.separator.label.algol68"
            }
          }
        },
        {
          "match": "\\b(GOTO|GO\\s+TO)\\s+([a-z][a-z0-9_]*+(?:[ \\t]++[a-z0-9][a-z0-9_]*+)*+)",
          "captures": {
            "1": {
              "name": "keyword.control.goto.algol68"
            },
            "2": {
              "name": "entity.name.label.algol68"
            }
          }
        }
      ]
    },
    "u-keyword": {
      "patterns": [
        {
          "match": "(?<![A-Z_])(?:ASSERT|DOWNTO|BEGIN|UNTIL|WHILE|CASE|ELIF|ELSE|ESAC|EXIT|FROM|GOTO|OUSE|THEN|END|FOR|OUT|PAR|BY|DO|FI|GO|IF|IN|OD|TO)(?![A-Z_])",
          "name": "keyword.control.algol68"
        },
        {
          "match": "(?<![A-Z_])(?:POSTLUDE|MODULE|DEF|EGG|FED)(?![A-Z_])",
          "name": "keyword.other.module.algol68"
        },
        {
          "match": "(?<![A-Z_])(?:MODE|PRIO|PROC|OP)(?![A-Z_])",
          "name": "storage.type.declaration.algol68"
        },
        {
          "match": "(?<![A-Z_])(?:CHANNEL|COMPLEX|FORMAT|STRING|BYTES|COMPL|SOUND|BITS|BOOL|CHAR|FILE|PIPE|REAL|SEMA|VOID|INT)(?![A-Z_])",
          "name": "storage.type.primitive.algol68"
        },
        {
          "match": "(?<![A-Z_])(?:STRUCT|SHORT|UNION|FLEX|HEAP|LONG|WORD|LOC|NEW|REF)(?![A-Z_])",
          "name": "storage.modifier.algol68"
        },
        {
          "match": "(?<![A-Z_])(?:EMPTY|FALSE|SKIP|TRUE|NIL)(?![A-Z_])",
          "name": "constant.language.algol68"
        },
        {
          "match": "(?<![A-Z_])(?:ANDTH|TRNSP|ANDF|DIAG|ELSF|ISNT|OREL|THEF|COL|ORF|ROW|AT|IS|OF)(?![A-Z_])",
          "name": "keyword.operator.wordlike.algol68"
        },
        {
          "match": "(?<![A-Z_])(?:ENVIRON|CLASS|ALIF|CODE|EDOC)(?![A-Z_])",
          "name": "keyword.other.algol68"
        }
      ]
    },
    "u-standard": {
      "patterns": [
        {
          "match": "(?<![a-z0-9_])(?:(?:long|short)[ \\t_]*)*(?:minus[ \\t_]*infinity|bytes[ \\t_]*width|bits[ \\t_]*width|real[ \\t_]*width|small[ \\t_]*real|exp[ \\t_]*width|int[ \\t_]*width|infinity|max[ \\t_]*bits|max[ \\t_]*real|min[ \\t_]*real|max[ \\t_]*int|min[ \\t_]*inf|min[ \\t_]*int|inf|pi)(?![a-z0-9_]|[ \\t]*[a-z0-9])",
          "name": "support.constant.algol68"
        },
        {
          "match": "(?<![a-z0-9_])(?:(?:long|short)[ \\t_]*)*(?:string[ \\t_]*to[ \\t_]*real|inverse[ \\t_]*erfc|inverse[ \\t_]*erf|last[ \\t_]*random|next[ \\t_]*random|bytes[ \\t_]*pack|bits[ \\t_]*pack|inv[ \\t_]*erfc|ln[ \\t_]*gamma|arc[ \\t_]*cos|arc[ \\t_]*sin|arc[ \\t_]*tan|inv[ \\t_]*erf|ln[ \\t_]*beta|cos[ \\t_]*dg|cos[ \\t_]*pi|cot[ \\t_]*dg|cot[ \\t_]*pi|csc[ \\t_]*dg|random|sec[ \\t_]*dg|sin[ \\t_]*dg|sin[ \\t_]*pi|tan[ \\t_]*dg|tan[ \\t_]*pi|gamma|ln[ \\t_]*1p|beta|cbrt|cosh|curt|erfc|sinh|sqrt|tanh|cos|cot|csc|erf|exp|log|sec|sin|tan|ln)(?![a-z0-9_]|[ \\t]*[a-z0-9])",
          "name": "support.function.algol68"
        },
        {
          "match": "(?<![a-z0-9_])(?:form[ \\t_]*feed[ \\t_]*character|stand[ \\t_]*error[ \\t_]*channel|new[ \\t_]*line[ \\t_]*character|stand[ \\t_]*back[ \\t_]*channel|stand[ \\t_]*draw[ \\t_]*channel|stand[ \\t_]*out[ \\t_]*channel|replacement[ \\t_]*char|stand[ \\t_]*in[ \\t_]*channel|blank[ \\t_]*character|file[ \\t_]*o[ \\t_]*default|form[ \\t_]*feed[ \\t_]*char|null[ \\t_]*character|bytes[ \\t_]*lengths|bytes[ \\t_]*shorths|compl[ \\t_]*lengths|compl[ \\t_]*shorths|file[ \\t_]*o[ \\t_]*rdonly|file[ \\t_]*o[ \\t_]*wronly|new[ \\t_]*line[ \\t_]*char|tab[ \\t_]*character|bits[ \\t_]*lengths|bits[ \\t_]*shorths|file[ \\t_]*o[ \\t_]*trunc|max[ \\t_]*abs[ \\t_]*char|real[ \\t_]*lengths|real[ \\t_]*shorths|file[ \\t_]*o[ \\t_]*rdwr|int[ \\t_]*lengths|int[ \\t_]*shorths|stand[ \\t_]*error|blank[ \\t_]*char|error[ \\t_]*char|stand[ \\t_]*back|null[ \\t_]*char|stand[ \\t_]*out|eof[ \\t_]*char|exp[ \\t_]*char|mp[ \\t_]*radix|seek[ \\t_]*cur|seek[ \\t_]*end|seek[ \\t_]*set|stand[ \\t_]*in|tab[ \\t_]*char|stderr|stdout|blank|stdin|flip|flop)(?![a-z0-9_]|[ \\t]*[a-z0-9])",
          "name": "support.constant.algol68"
        },
        {
